    {
      "parameters": {
        "jsCode": "const { S3Client, GetObjectCommand } = require('@aws-sdk/client-s3');\nconst { getSignedUrl } = require('@aws-sdk/s3-request-presigner');\n\n// === 1. Получаем входные данные ===\nconst fileName = $('ReadFile').item.binary.data.fileName;\n\n// === 2. Конфигурация ===\nconst bucketName = 'ocr';\nconst expirySeconds = 3600; // 1 час\n\ntry {\n  // === 3. Инициализация S3 клиента (настроенного на MinIO) ===\n  const client = new S3Client({\n    region: 'us-east-1', // Для MinIO region не важен, но нужен SDK\n    endpoint: 'http://minio:9000', // DNS-имя контейнера\n    credentials: {\n      accessKeyId: 'minioadmin',\n      secretAccessKey: 'minioadmin',\n    },\n    forcePathStyle: true, // КРИТИЧЕСКИ ВАЖНО для MinIO!\n  });\n\n  // === 4. Формирование команды ===\n  const command = new GetObjectCommand({\n    Bucket: bucketName,\n    Key: fileName,\n  });\n\n  // === 5. Генерация presigned URL ===\n  const presignedUrl = await getSignedUrl(client, command, { expiresIn: expirySeconds });\n\n  // === 6. Возврат результата ===\n  return [{\n    json: {\n      filename: fileName,\n      bucket: bucketName,\n      internalurl: presignedUrl,\n      expiresAt: new Date(Date.now() + expirySeconds * 1000).toISOString()\n    }\n  }];\n\n} catch (error) {\n  const errorDetails = error?.message || String(error);\n  console.error('❌ MinIO/S3 Error:', errorDetails);\n\n  return [{\n    json: {\n      error: true,\n      message: errorDetails,\n      fileName,\n      hint: errorDetails.includes('NoSuchKey') ? 'Файл не найден в бакете' :\n            errorDetails.includes('ECONNREFUSED') ? 'MinIO недоступен' :\n            'Проверьте логи и настройки бакета'\n    }\n  }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
