    {
      "parameters": {
        "jsCode": "// 1. Забираем данные триггера (замените 'Telegram Trigger' на точное название вашей ноды)\n// const triggerData = $('Telegram Trigger').first().json;\n// const rawText = triggerData?.message?.text || triggerData?.text || '';\n// const query = rawText.trim().toLowerCase();\nconst query = $('On form submission').first().json.text.toLowerCase();\n\n// 2. Забираем распаршенные строки из предыдущей ноды (Spreadsheet File)\nconst employees = $input.all().map(item => item.json);\n\n// 3. Фильтрация\nconst filtered = employees.filter(emp => {\n  const fio = (emp.name || '').toLowerCase();\n  const city = (emp.city || '').toLowerCase();\n  return fio.includes(query) || city.includes(query);\n});\n\n// 4. Формирование ответа\nconst results = [];\n\nfiltered.forEach(emp => {\n  // Push into the results array using n8n's required structure\n  results.push({\n    json: {\n      ...emp,           // Keep existing fields\n      processed_at: new Date() // Add custom fields if needed\n    }\n  });\n});\n\n// let responseJson = [{json: {results}}];\nreturn [{json: {filtered}}];\n\n// 5. Возвращаем результат + chatId из триггера\n// return [{\n//   json: {\n//     responseText,\n//     chatId: triggerData?.message?.chat?.id || triggerData?.chat?.id\n//   }\n// }];\n  // return [{\n  //   json: {\n  //     responseText  } \n  //   }];\n\n"
      },
